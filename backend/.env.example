# Warranty Vault local AI bridge (port 3000)
# All variables optional — defaults shown.
PORT=3000
QWEN_BASE_URL=http://127.0.0.1:8080/v1
QWEN_MODEL=qwen
QWEN_EXTRACT_TIMEOUT_MS=90000
# Any localhost/127.0.0.1 origin is always accepted (Vite ports are dynamic).
# Add comma-separated explicit origins here if you deploy the frontend.
ALLOWED_ORIGIN=http://localhost:5173
